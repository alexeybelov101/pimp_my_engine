#pragma once
#include "../../Interfaces/INode.hpp"
#include "../../Structs/Cell.hpp"
#include "../../Structs/Flux.hpp"

#include <cstdint>
#include <fstream>
#include <string>
#include <vector>

class Atmosphere : public INode {
public:
    Atmosphere();
    ~Atmosphere() override;

    const IBoundary& getBoundary(bool isLeft) const override;
    void step(double dt) override;

    void resetFlux();

    // === запись WAV ===
    void startRecording(const std::string& path, uint32_t sampleRate);
    void stopRecording();

private:
    class AtmosphereBoundary : public IBoundary {
    public:
        AtmosphereBoundary(Atmosphere* owner, bool isLeft);
        ~AtmosphereBoundary() override = default;

        Cell getState() const override;
        void setFlux(const Flux& flux) const override;
        double getArea() const override;
        bool isLeft() const override;

    private:
        Atmosphere* owner_;
        bool isLeft_;
    };

    AtmosphereBoundary leftBoundary_;
    AtmosphereBoundary rightBoundary_;
    const Cell cell_;

    Flux flux_;

    // === WAV-писатель ===
    std::ofstream wav_;
    std::vector<int16_t> wavSamples_;
    uint32_t wavSampleRate_ = 48000;
    bool recording_ = false;

    void writeWavHeader();      // вызывается в stopRecording
    void pushSample(double dP); // вызывается в step
};
